{
  "name": "cookedchat",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build:shared": "pnpm --filter @cooked/shared build",
    "dev:server": "pnpm --filter @cooked/server dev",
    "dev:web": "pnpm --filter @cooked/web dev",
    "build": "pnpm -r build",
    "local": "pnpm build && pnpm --parallel --filter @cooked/server --filter @cooked/web start",
    "test": "pnpm -r test"
  },
  "engines": { "node": ">=20.11" }
}
