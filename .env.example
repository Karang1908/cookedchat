# ═════════════════════════════════════════════════════════════════════════════
# RENDER: everything runs there. Two services from render.yaml (New → Blueprint → this repo):
#   cookedchat-server  (Nest + Socket.IO)  →  paste block 1 below
#   cookedchat-web     (Next.js)           →  paste block 2 below
# Where: Render → the service → Environment → "Add from .env" → paste the block → replace
# every REPLACE_ME / xxxx value → Save. Do not add PORT: Render sets it.
# Any value left as a placeholder is ignored by the server (logged at boot), so a half-filled
# paste never breaks a deploy: missing AI keys just mean canned lines.
#
# Real keys go into Render only. Never commit them to this file.
# ═════════════════════════════════════════════════════════════════════════════


# ─── BLOCK 1 · cookedchat-server ─────────────────────────────────────────────

# REQUIRED. Password for /admin/<ROOM CODE>. Make one: `openssl rand -base64 24`
ADMIN_KEY=REPLACE_ME_with_a_long_random_password

# REQUIRED. The web service's URL, no trailing slash (comma-separate several).
# Render shows it at the top of the cookedchat-web page.
CORS_ORIGINS=https://cookedchat-web.onrender.com

# AI. Groq: console.groq.com → API Keys → Create (starts with gsk_).
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AI. Ollama Cloud: ollama.com → Settings → Keys → Add.
# The Groq-vs-Ollama duel (admin toggle) needs both keys; one is enough for roasts.
OLLAMA_API_KEY=REPLACE_ME_ollama_cloud_key
LLM_ORDER=groq-120b,groq-20b,ollama
LLM_ATTEMPT_TIMEOUT_MS=2500
LLM_DEADLINE_MS=3500

# Persistence (optional, but without it rooms vanish on every restart/sleep).
# Supabase → Connect → "Session pooler" URI (IPv4, works from Render). Put your DB password in.
# Run supabase/migrations/0001_init.sql then 0002_features.sql in the SQL editor first.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:REPLACE_ME_db_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# GIFs on big moments (optional). developers.giphy.com → Create an App → API.
GIPHY_API_KEY=REPLACE_ME_giphy_key

NODE_VERSION=22


# ─── BLOCK 2 · cookedchat-web ────────────────────────────────────────────────
# NEXT_PUBLIC_* is baked in at build time: after changing it, Manual Deploy → "Clear build cache & deploy".

# REQUIRED. The server service's URL, no trailing slash.
NEXT_PUBLIC_SERVER_URL=https://cookedchat-server.onrender.com

# optional: real meme clips you add as apps/web/public/sounds/<name>.mp3 (otherwise synthesized).
# names: vineBoom,fahhh,bruh,airhorn,pipe,sadViolin,scream,tungTung,winError,dunDunDun,crickets
NEXT_PUBLIC_SOUND_CLIPS=

# optional: a muted looping video in apps/web/public for the "retention zone" (otherwise a placeholder)
NEXT_PUBLIC_GAMEPLAY_SRC=

NODE_VERSION=22
