# ─────────────────────────────────────────────────────────────────────────────
# VERCEL (the web app). Paste this whole block into:
#   Vercel → your project → Settings → Environment Variables → "Import .env" (or paste)
# Project settings: Root Directory = apps/web, Framework = Next.js (install/build are auto-detected).
#
# The realtime server can't run on Vercel (it needs WebSockets). Deploy it on Render with
# render.yaml, and paste apps/server/.env.example into Render → Environment.
# NEXT_PUBLIC_* values are baked in at build time: redeploy after changing them.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED: your Render server URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=https://cookedchat-server.onrender.com

# optional: real meme sound clips you put in apps/web/public/sounds/<name>.mp3 (otherwise they are synthesized)
# names: vineBoom,fahhh,bruh,airhorn,pipe,sadViolin,scream,tungTung,winError,dunDunDun,crickets
NEXT_PUBLIC_SOUND_CLIPS=

# optional: a muted looping video in apps/web/public for the "retention zone" (otherwise a placeholder)
NEXT_PUBLIC_GAMEPLAY_SRC=
