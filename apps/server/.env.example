# Local dev: copy to apps/server/.env (`pnpm dev:server` loads it). For Render, use the root .env.example.
# Placeholders are ignored, so you only need to fill in what you want to try.

ADMIN_KEY=REPLACE_ME_local_admin_password
# CORS_ORIGINS unset = any origin (fine locally)

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OLLAMA_API_KEY=REPLACE_ME_ollama_cloud_key
GIPHY_API_KEY=REPLACE_ME_giphy_key

# unset = in-memory rooms. A local Postgres: postgresql://postgres:postgres@localhost:5432/cooked + DATABASE_SSL=false
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:REPLACE_ME_db_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
