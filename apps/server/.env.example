# ─────────────────────────────────────────────────────────────────────────────
# RENDER (the realtime server). Paste into Render → your service → Environment.
# Render sets PORT itself: do not add it there. For local dev, copy this file to apps/server/.env.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED: password for /admin/<ROOM CODE> (unset = admin panel disabled)
ADMIN_KEY=change-me-to-something-long

# REQUIRED in production: your Vercel URL(s), comma-separated, no trailing slash (unset = any origin, dev only)
CORS_ORIGINS=https://your-app.vercel.app

# AI providers (free tiers). Without any key the AI uses canned lines only.
# Groq: console.groq.com → API Keys.   Ollama Cloud: ollama.com → Settings → Keys.
# The Groq-vs-Ollama duel (admin toggle) needs both.
GROQ_API_KEY=
OLLAMA_API_KEY=
LLM_ORDER=groq-120b,groq-20b,ollama
LLM_ATTEMPT_TIMEOUT_MS=2500
LLM_DEADLINE_MS=3500

# Persistence (Supabase → Project Settings → Database → Connection string, "Session pooler" works from Render).
# Run supabase/migrations/*.sql first. Unset = rooms live in memory and vanish on restart.
DATABASE_URL=
DATABASE_SSL=true

# optional: trending GIFs on big moments (developers.giphy.com)
GIPHY_API_KEY=

