PORT=4000
# required for /admin/<code>; unset = admin disabled
ADMIN_KEY=change-me
# comma-separated allowed web origins; unset allows any origin (dev only)
CORS_ORIGINS=http://localhost:3000
# optional: without it rooms live in memory and vanish on restart
DATABASE_URL=
DATABASE_SSL=true
# optional: without any key the commentator uses canned lines only
GROQ_API_KEY=
OLLAMA_API_KEY=
LLM_ORDER=groq-120b,groq-20b,ollama
LLM_ATTEMPT_TIMEOUT_MS=2500
LLM_DEADLINE_MS=3500
